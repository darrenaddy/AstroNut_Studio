{
  "name": "astrophile-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astrophile Studio — a visual, AI-assisted editor for Astro sites that runs in your browser.",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "postinstall": "npm --prefix site install --no-audit --no-fund",
    "typecheck": "tsc --noEmit -p editor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "chokidar": "^4",
    "chrome-launcher": "^1.2.3",
    "codemirror": "^6",
    "express": "^5",
    "gray-matter": "^4",
    "lighthouse": "^13.6.0",
    "lucide-react": "latest",
    "marked": "latest",
    "react": "^19",
    "react-dom": "^19",
    "vite": "latest",
    "zustand": "^5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
