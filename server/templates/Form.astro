---
// A form made with the form builder. Add, remove and reorder its fields in the
// editor; every placement can also override them for one page.
// Submissions go to Formspree (https://formspree.io) — paste your form's ID into "Send to".
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  /** Your Formspree form ID (the letters after formspree.io/f/). Any full address that accepts form posts also works. */
  sendTo?: string;
  /** Subject line of the email you receive for each submission. */
  subject?: string;
  submitLabel?: string;
  /** Shown in place of the form once it has been sent. */
  successMessage?: string;
  /** "card" puts the form in a bordered panel; "plain" leaves it on the page background. */
  layout?: 'card' | 'plain';
  fields?: Array<{
    label: string;
    type: 'text' | 'email' | 'phone' | 'number' | 'date' | 'long text' | 'dropdown' | 'choice' | 'checkbox' | 'file';
    placeholder: string;
    required: boolean;
    /** Sit side by side with the next field on wide screens. */
    half: boolean;
    /** For dropdown and choice fields: one option per line. */
    options: string[];
  }>;
}
const {
  eyebrow = "Get in touch",
  title = "Send us a message",
  text = "Tell us a little about what you need and we will get back to you within one working day.",
  sendTo = "",
  subject = "New message from the website",
  submitLabel = "Send message",
  successMessage = "Thank you — your message is on its way. We will reply soon.",
  layout = "card",
  fields = [
    { label: "Name", type: "text", placeholder: "Ada Lovelace", required: true, half: true, options: [] },
    { label: "Email", type: "email", placeholder: "ada@example.com", required: true, half: true, options: [] },
    { label: "Message", type: "long text", placeholder: "How can we help?", required: true, half: false, options: [] },
  ],
} = Astro.props;

// Where the form posts to.
const target = sendTo.trim();
const action = !target ? '' : /^https?:\/\//.test(target) ? target : `https://formspree.io/f/${target}`;

// Each input needs a unique name; it is made from the field's label.
const uid = 'f' + crypto.randomUUID().slice(0, 6);
const taken = new Set<string>();
const inputs = fields.map((field) => {
  const base = String(field.label || 'field').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'field';
  let name = base;
  for (let n = 2; taken.has(name); n++) name = `${base}-${n}`;
  taken.add(name);
  return { ...field, name, id: `${uid}-${name}`, kind: { phone: 'tel', 'long text': 'textarea', dropdown: 'select', choice: 'radio' }[field.type] ?? field.type };
});
const hasFile = inputs.some((f) => f.kind === 'file');
const control = 'mt-2 w-full rounded-xl border border-line bg-bg px-4 py-3 text-fg placeholder:text-muted focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500';
---

<section class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-6">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted">{text}</p>
    </div>

    <form action={action || undefined} method="post" enctype={hasFile ? 'multipart/form-data' : undefined} data-built-form class={layout === 'card' ? 'mt-12 rounded-card border border-line bg-surface p-6 shadow-sm sm:p-10' : 'mt-12'}>
      {!action && import.meta.env.DEV && <p class="mb-6 rounded-xl border border-dashed border-brand-400 bg-brand-50 px-4 py-3 text-sm text-brand-800 dark:bg-brand-950/40 dark:text-brand-200">This form is not connected yet. Add your Formspree form ID in the “Send to” field. (Visitors never see this note.)</p>}
      <input type="hidden" name="_subject" value={subject} />
      <p class="hidden" aria-hidden="true">
        <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="grid gap-6 sm:grid-cols-2">
        {
          inputs.map((field) => (
            <div class={field.half ? '' : 'sm:col-span-2'}>
              {field.kind === 'checkbox' ? (
                <label class="flex items-start gap-3 text-fg">
                  <input type="checkbox" name={field.name} value="yes" required={field.required} class="mt-1 h-5 w-5 rounded border-line text-brand-600 accent-brand-600" />
                  <span>{field.label}</span>
                </label>
              ) : field.kind === 'radio' ? (
                <fieldset>
                  <legend class="text-sm font-semibold text-fg">{field.label}</legend>
                  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3">
                    {field.options.map((option) => (
                      <label class="flex items-center gap-2 text-fg">
                        <input type="radio" name={field.name} value={option} required={field.required} class="h-4 w-4 accent-brand-600" />
                        <span>{option}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ) : (
                <>
                  <label for={field.id} class="text-sm font-semibold text-fg">{field.label}</label>
                  {field.kind === 'textarea' ? (
                    <textarea id={field.id} name={field.name} rows="5" placeholder={field.placeholder} required={field.required} class={control} />
                  ) : field.kind === 'select' ? (
                    <select id={field.id} name={field.name} required={field.required} class={control}>
                      <option value="">{field.placeholder || 'Choose…'}</option>
                      {field.options.map((option) => <option>{option}</option>)}
                    </select>
                  ) : (
                    <input id={field.id} type={field.kind} name={field.name} placeholder={field.placeholder} required={field.required} class={field.kind === 'file' ? 'mt-2 block w-full text-sm text-muted file:mr-4 file:rounded-button file:border-0 file:bg-brand-600 file:px-4 file:py-2 file:font-semibold file:text-white' : control} />
                  )}
                </>
              )}
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <button type="submit" class="rounded-button bg-brand-600 px-7 py-3.5 font-semibold text-white transition hover:bg-brand-700 disabled:opacity-60">{submitLabel}</button>
        <p data-form-error class="hidden text-sm font-medium text-red-600" role="alert">Sorry, that did not send. Please try again in a moment.</p>
      </div>
    </form>

    <div data-form-success class="mt-12 hidden rounded-card border border-line bg-surface p-10 text-center" role="status">
      <p class="font-display text-2xl font-semibold tracking-tight text-fg">{successMessage}</p>
    </div>
  </div>
</section>

<script is:inline>
  // Sends the form in the background and shows the thank-you message in place.
  // If that is not possible, the browser submits it the ordinary way instead.
  for (const form of document.querySelectorAll('form[data-built-form]:not([data-ready])')) {
    form.setAttribute('data-ready', '');
    form.addEventListener('submit', async (event) => {
      const error = form.querySelector('[data-form-error]');
      if (!form.getAttribute('action')) {
        event.preventDefault();
        error.textContent = 'This form is not connected to anything yet.';
        error.classList.remove('hidden');
        return;
      }
      if (form.dataset.sent === 'native') return;
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      error.classList.add('hidden');
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (response.ok) {
          form.classList.add('hidden');
          form.parentElement.querySelector('[data-form-success]').classList.remove('hidden');
          form.reset();
        } else {
          error.classList.remove('hidden');
        }
      } catch {
        // Could not reach the service from script — let the browser post the form normally.
        form.dataset.sent = 'native';
        form.submit();
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
