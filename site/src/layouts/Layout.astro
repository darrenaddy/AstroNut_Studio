---
// The shell every page shares: <head>, the header, the footer.
// A page's own content is rendered where <slot /> is.
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/footer/Footer.astro';

const { title = 'Halcyon — Calm software for busy teams', description = 'Halcyon is calm project planning for small teams: fewer meetings, clearer weeks, work that ships.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-code" />
    <title>{title}</title>
  </head>
  <body class="bg-bg font-sans text-fg antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
