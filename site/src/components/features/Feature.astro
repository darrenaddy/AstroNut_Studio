---
// Section heading above a three-column grid of six feature cards with brand-tinted icons.
const {
  features = [
    {
      icon: "<svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"> <rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15\" rx=\"2.5\" /> <path d=\"M3.5 10h17\" /> <path d=\"M8 3v4\" /> <path d=\"M16 3v4\" /> </svg>",
      title: "Weekly plans",
      text: "Set the week's priorities on Monday in five minutes. Everyone sees what matters and what can wait.",
    },
    {
      icon: "<svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"> <path d=\"M4 7h10\" /> <path d=\"M8 12h12\" /> <path d=\"M4 17h8\" /> </svg>",
      title: "Gentle timelines",
      text: "Drag work across a simple timeline. When one date slips, everything downstream adjusts on its own.",
    },
    {
      icon: "<svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"> <path d=\"M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z\" /> </svg>",
      title: "Quiet Hours",
      text: "Notifications are held until your working hours, then delivered as one tidy summary instead of forty pings.",
    },
    {
      icon: "<svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"> <path d=\"M4 20V10\" /> <path d=\"M10 20V4\" /> <path d=\"M16 20v-7\" /> <path d=\"M22 20H2\" /> </svg>",
      title: "Progress without asking",
      text: "Live project health for every initiative, written in plain language. No more \"any update on this?\"",
    },
    {
      icon: "<svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"> <path d=\"M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z\" /> </svg>",
      title: "Async check-ins",
      text: "A two-question update replaces the daily stand-up. Answer when it suits you; read them over coffee.",
    },
    {
      icon: "<svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"> <circle cx=\"9\" cy=\"8\" r=\"3.5\" /> <path d=\"M2.5 20c.6-3.4 3.2-5.5 6.5-5.5s5.900 2.100 6.500 5.500\" /> <path d=\"M16 4.800a3.500 3.500 0 0 1 0 6.400\" /> <path d=\"M18.500 14.900c1.600.800 2.700 2.500 3 5.100\" /> </svg>",
      title: "Workload at a glance",
      text: "See who has room and who is stretched before you assign the next thing, not after someone burns out.",
    },
  ],
  title = "Everything a small team needs. Nothing it doesn't.",
} = Astro.props;
---

<section id="features" class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-widest text-brand-600 uppercase dark:text-brand-400">Features</p>
      <h2 class="mt-4 font-display text-4xl font-semibold tracking-tight text-balance text-fg sm:text-5xl">{title}</h2>
      <p class="mt-5 text-lg leading-8 text-pretty text-muted">Halcyon replaces the tangle of boards, docs and check-in meetings with a handful of tools that stay out of your way.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((item) => (
          <div class="rounded-card border border-line bg-bg p-7 transition-shadow hover:shadow-lg hover:shadow-brand-950/5">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-300">
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="mt-6 font-display text-xl font-semibold tracking-tight text-fg">{item.title}</h3>
            <p class="mt-2 text-base leading-7 text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
