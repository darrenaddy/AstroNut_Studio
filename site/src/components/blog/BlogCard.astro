---
import SmartImage from '../media/SmartImage.astro';
// A card for one blog post. It is "dynamic": the text comes from the post
// you pass in (see BlogList.astro), not from this file.
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="group flex flex-col overflow-hidden rounded-card border border-line bg-bg transition hover:-translate-y-1 hover:shadow-xl">
  <a href={`/blog/${post.id}`} class="block aspect-[16/9] overflow-hidden bg-surface">
    {post.data.heroImage && <SmartImage src={post.data.heroImage} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" alt="" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />}
  </a>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm text-muted">{date} · {post.data.author}</p>
    <h3 class="mt-3 font-display text-xl font-semibold tracking-tight">
      <a href={`/blog/${post.id}`} class="hover:text-brand-600">{post.data.title}</a>
    </h3>
    <p class="mt-2 flex-1 text-muted">{post.data.description}</p>
    <a href={`/blog/${post.id}`} class="mt-5 text-sm font-semibold text-brand-600">Read the post →</a>
  </div>
</article>
