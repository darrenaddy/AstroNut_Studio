---
// Lists the newest posts from the "blog" content collection.
// Add or edit posts in the editor's Content tab — this list updates by itself.
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';

const { limit = 3 } = Astro.props;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">From the blog</p>
        <h2 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">Notes on working calmly</h2>
      </div>
      <a href="/blog" class="rounded-button border border-line px-5 py-2.5 text-sm font-semibold hover:bg-surface">All posts</a>
    </div>
    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </div>
</section>
