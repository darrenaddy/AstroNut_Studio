---
// Contact form — contact details on the left, form card on the right.
---

<section class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">Contact</p>
        <h2 class="mt-4 font-display text-4xl font-semibold tracking-tight text-fg sm:text-5xl">Let's talk about your team</h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">Tell us how you plan work today and where it gets noisy. We will reply with honest advice, even if Halcyon is not the right fit.</p>

        <ul class="mt-12 space-y-8">
          <li class="flex gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-300">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                <path d="M3.5 7.5l8.5 6 8.5-6"></path>
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-medium tracking-tight text-fg">Email</h3>
              <a href="mailto:hello@halcyon.app" class="mt-1 block text-muted transition hover:text-brand-600 dark:hover:text-brand-400">hello@halcyon.app</a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-300">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.800 12 21 12 21z"></path>
                <circle cx="12" cy="9.5" r="2.5"></circle>
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-medium tracking-tight text-fg">Office</h3>
              <p class="mt-1 text-muted">14 Lantern Yard, Clerkenwell</p>
              <p class="text-muted">London EC1R 4QT</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-300">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3.5 2"></path>
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-medium tracking-tight text-fg">Hours</h3>
              <p class="mt-1 text-muted">Monday to Friday, 9am to 5pm GMT</p>
              <p class="text-muted">We reply within one working day.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="rounded-card border border-line bg-bg p-6 shadow-xl shadow-brand-950/5 sm:p-10">
        <h3 class="font-display text-2xl font-semibold tracking-tight text-fg">Send us a note</h3>
        <p class="mt-2 text-sm text-muted">All fields are required.</p>

        <form action="#" method="post" class="mt-8 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-fg">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required placeholder="Ada Lindqvist" class="mt-2 block w-full rounded-xl border border-line bg-bg px-4 py-3 text-fg placeholder:text-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-fg">Work email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required placeholder="ada@studio.com" class="mt-2 block w-full rounded-xl border border-line bg-bg px-4 py-3 text-fg placeholder:text-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>
          </div>
          <div>
            <label for="contact-team-size" class="block text-sm font-medium text-fg">Team size</label>
            <select id="contact-team-size" name="team-size" required class="mt-2 block w-full rounded-xl border border-line bg-bg px-4 py-3 text-fg focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="1-5">1 to 5 people</option>
              <option value="6-15">6 to 15 people</option>
              <option value="16-50">16 to 50 people</option>
              <option value="51+">More than 50 people</option>
            </select>
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-medium text-fg">Message</label>
            <textarea id="contact-message" name="message" rows="5" required placeholder="What does a typical week look like for your team?" class="mt-2 block w-full resize-y rounded-xl border border-line bg-bg px-4 py-3 text-fg placeholder:text-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
          </div>
          <button type="submit" class="inline-flex w-full items-center justify-center rounded-button bg-brand-600 px-7 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-bg">Send message</button>
          <p class="text-center text-xs leading-relaxed text-muted">We only use your details to reply to this message. No mailing lists, ever.</p>
        </form>
      </div>
    </div>
  </div>
</section>
