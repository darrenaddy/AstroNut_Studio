---
// Footer — wordmark, four link columns and a bottom bar with social links.
---

<footer class="border-t border-line bg-surface pt-16 sm:pt-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9c3-3 6-3 9 0s6 3 9 0"></path>
              <path d="M3 15c3-3 6-3 9 0s6 3 9 0"></path>
            </svg>
          </span>
          <span class="font-display text-xl font-semibold tracking-tight text-fg">Halcyon</span>
        </a>
        <p class="mt-5 max-w-xs leading-relaxed text-muted">Calm software for busy teams. Plan the week, protect your focus and finish on time.</p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-4 lg:col-span-2">
        <div>
          <h3 class="text-sm font-semibold text-fg">Product</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a href="/" class="text-muted transition hover:text-fg">Overview</a></li>
            <li><a href="/pricing" class="text-muted transition hover:text-fg">Pricing</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Integrations</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Changelog</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-fg">Company</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a href="/about" class="text-muted transition hover:text-fg">About</a></li>
            <li><a href="/blog" class="text-muted transition hover:text-fg">Blog</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Careers</a></li>
            <li><a href="/contact" class="text-muted transition hover:text-fg">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-fg">Resources</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a href="#" class="text-muted transition hover:text-fg">Help centre</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Templates</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">API docs</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">System status</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-fg">Legal</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a href="#" class="text-muted transition hover:text-fg">Privacy</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Terms</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Security</a></li>
            <li><a href="#" class="text-muted transition hover:text-fg">Cookies</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col-reverse items-center justify-between gap-6 border-t border-line py-8 sm:flex-row">
      <p class="text-sm text-muted">© 2026 Halcyon Labs, Inc. All rights reserved.</p>
      <div class="flex items-center gap-2">
        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full text-muted transition hover:bg-bg hover:text-fg">
          <span class="sr-only">Halcyon on X</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </a>
        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full text-muted transition hover:bg-bg hover:text-fg">
          <span class="sr-only">Halcyon on LinkedIn</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3.5"></rect>
            <path d="M8 11v5.500M8 7.750v.01M12 16.500V11M12 13.500a2 2 0 0 1 4 0v3"></path>
          </svg>
        </a>
        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full text-muted transition hover:bg-bg hover:text-fg">
          <span class="sr-only">Halcyon on YouTube</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="5.500" width="19" height="13" rx="4"></rect>
            <path d="M10 9.500l5 2.500-5 2.500z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
