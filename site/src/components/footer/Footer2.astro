---
// Footer 2 — minimal single row: wordmark, inline links, copyright.
---

<footer class="border-t border-line bg-bg py-10">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-6 lg:flex-row lg:justify-between">
      <a href="/" class="inline-flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-brand-600 text-white">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9c3-3 6-3 9 0s6 3 9 0"></path>
            <path d="M3 15c3-3 6-3 9 0s6 3 9 0"></path>
          </svg>
        </span>
        <span class="font-display text-lg font-semibold tracking-tight text-fg">Halcyon</span>
      </a>

      <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
        <a href="/pricing" class="text-muted transition hover:text-fg">Pricing</a>
        <a href="/about" class="text-muted transition hover:text-fg">About</a>
        <a href="/blog" class="text-muted transition hover:text-fg">Blog</a>
        <a href="/contact" class="text-muted transition hover:text-fg">Contact</a>
        <a href="#" class="text-muted transition hover:text-fg">Privacy</a>
      </nav>

      <p class="text-sm text-muted">© 2026 Halcyon Labs, Inc.</p>
    </div>
  </div>
</footer>
