---
// Testimonials: heading plus three quote cards.
const {
  testimonials = [
    {
      quote: "We cancelled our Monday stand-up in week two. Everything we used to say out loud is already on the board, and nobody misses the meeting.",
      image: "/media/avatar-1.svg",
      alt: "Portrait of Priya Raman",
      name: "Priya Raman",
      role: "Head of Product, Northwind",
    },
    {
      quote: "Halcyon is the first planning tool my engineers did not ask to turn off. It tells you what matters today and then gets out of the way.",
      image: "/media/avatar-2.svg",
      alt: "Portrait of Tomás Herrera",
      name: "Tomás Herrera",
      role: "Engineering Lead, Kestrel",
    },
    {
      quote: "Our clients can see exactly where their project stands without emailing us. That one shared timeline has saved our studio a full day every week.",
      image: "/media/avatar-3.svg",
      alt: "Portrait of Amara Osei",
      name: "Amara Osei",
      role: "Studio Director, Lumina",
    },
  ],
  title = "Loved by teams who would rather be working",
} = Astro.props;
---

<section class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">Customer stories</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">Small teams in design, engineering and operations use Halcyon to keep the week clear and the noise down.</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((item) => (
          <figure class="flex flex-col rounded-card border border-line bg-surface p-8">
            <svg class="h-8 w-8 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 7H6a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h2v1a3 3 0 0 1-3 3" />
              <path d="M20 7h-4a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h2v1a3 3 0 0 1-3 3" />
            </svg>
            <blockquote class="mt-6 flex-1">
              <p class="text-lg leading-relaxed text-fg">{item.quote}</p>
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4 border-t border-line pt-6">
              <img src={item.image} alt={item.alt} width="48" height="48" loading="lazy" class="h-12 w-12 rounded-full object-cover" />
              <div>
                <p class="text-sm font-semibold text-fg">{item.name}</p>
                <p class="text-sm text-muted">{item.role}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
