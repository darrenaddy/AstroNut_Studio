---
import SmartImage from '../media/SmartImage.astro';
// Centred hero: announcement pill, huge headline, two buttons and a framed product screenshot with a brand glow.
const {
  announcement = "Quiet Hours: notifications that wait until you are ready",
  title = "Calm software for busy teams",
  subtitle = "Halcyon brings your plans, priorities and progress into one quiet workspace, so a small team can ship big work without the noise.",
  buttonLabel = "Start free",
  buttonLink = "/contact",
  secondLabel = "See how it works",
  secondLink = "/#features",
  finePrint = "Free for teams of up to five. No credit card needed.",
  image = "/media/app-dashboard.svg",
} = Astro.props;
---

<section class="relative overflow-hidden bg-bg pt-20 pb-20 sm:pt-28 sm:pb-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[32rem] bg-linear-to-b from-brand-50 to-transparent dark:from-brand-950/40" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <a href="/blog" class="inline-flex items-center gap-2 rounded-button border border-line bg-bg/70 py-1 pr-3 pl-1 text-sm text-muted shadow-sm backdrop-blur transition-colors hover:text-fg">
        <span class="rounded-button bg-brand-600 px-2.5 py-0.5 text-xs font-semibold text-white">New</span>
        <span>{announcement}</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="M13 6l6 6-6 6" />
        </svg>
      </a>

      <h1 class="mt-8 font-display text-5xl font-semibold tracking-tight text-balance text-fg sm:text-6xl lg:text-7xl">{title}</h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-pretty text-muted sm:text-xl">{subtitle}</p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={buttonLink} class="w-full rounded-button bg-brand-600 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 sm:w-auto">{buttonLabel}</a>
        <a href={secondLink} class="inline-flex w-full items-center justify-center gap-2 rounded-button border border-line bg-bg px-6 py-3 text-base font-semibold text-fg transition-colors hover:bg-surface sm:w-auto">
          <span>{secondLabel}</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <p class="mt-5 text-sm text-muted">{finePrint}</p>
    </div>

    <div class="relative mt-16 sm:mt-20">
      <div class="pointer-events-none absolute -inset-x-6 -top-10 bottom-10 rounded-full bg-linear-to-tr from-brand-500/40 via-brand-300/40 to-brand-200/30 blur-3xl dark:from-brand-600/40 dark:via-brand-700/30 dark:to-brand-900/30" aria-hidden="true"></div>
      <div class="relative rounded-card border border-line bg-surface p-2 shadow-2xl shadow-brand-950/20 sm:p-3">
        <div class="flex items-center gap-1.5 px-2 pt-1 pb-3 sm:pb-4">
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        </div>
        <SmartImage src={image} priority alt="The Halcyon dashboard showing this week's plan, project progress and upcoming milestones" width="1440" height="900" class="w-full rounded-xl border border-line" />
      </div>
    </div>
  </div>
</section>
