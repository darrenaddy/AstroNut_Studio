---
// Team: heading plus a four-column grid of eight people.
const {
  people = [
    {
      image: "/media/avatar-1.svg",
      alt: "Portrait of Elena Vasquez",
      name: "Elena Vasquez",
      role: "Co-founder and CEO",
    },
    {
      image: "/media/avatar-2.svg",
      alt: "Portrait of Jonas Lindqvist",
      name: "Jonas Lindqvist",
      role: "Co-founder and CTO",
    },
    {
      image: "/media/avatar-3.svg",
      alt: "Portrait of Naomi Okafor",
      name: "Naomi Okafor",
      role: "Head of Design",
    },
    {
      image: "/media/avatar-4.svg",
      alt: "Portrait of Hiro Tanaka",
      name: "Hiro Tanaka",
      role: "Principal Engineer",
    },
    {
      image: "/media/avatar-5.svg",
      alt: "Portrait of Clara Whitfield",
      name: "Clara Whitfield",
      role: "Head of Customer Success",
    },
    {
      image: "/media/avatar-6.svg",
      alt: "Portrait of Samir Patel",
      name: "Samir Patel",
      role: "Product Manager",
    },
    {
      image: "/media/avatar-7.svg",
      alt: "Portrait of Maya Goldberg",
      name: "Maya Goldberg",
      role: "Senior Product Designer",
    },
    {
      image: "/media/avatar-8.svg",
      alt: "Portrait of Luca Moretti",
      name: "Luca Moretti",
      role: "Developer Advocate",
    },
  ],
  title = "A small team, on purpose",
} = Astro.props;
---

<section class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">Our team</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">Halcyon is built by twenty-two people across six time zones. We work four-day weeks, write things down, and use our own product to plan every release.</p>
    </div>

    <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4">
      {
        people.map((item) => (
          <li>
            <img src={item.image} alt={item.alt} width="400" height="400" loading="lazy" class="aspect-square w-full rounded-card border border-line bg-surface object-cover" />
            <h3 class="mt-5 font-display text-lg font-semibold tracking-tight text-fg">{item.name}</h3>
            <p class="mt-1 text-sm text-muted">{item.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
