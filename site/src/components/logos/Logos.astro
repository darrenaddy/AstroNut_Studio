---
// Centred "trusted by" caption above a single row of six customer logos.
---

<section class="bg-bg py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-center text-sm font-medium tracking-wide text-muted">Trusted by calm teams at</p>
    <div class="mt-8 grid grid-cols-2 items-center justify-items-center gap-x-8 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
      <img src="/media/logo-northwind.svg" alt="Northwind" height="28" class="h-7 w-auto opacity-70 transition-opacity hover:opacity-100" />
      <img src="/media/logo-lumina.svg" alt="Lumina" height="28" class="h-7 w-auto opacity-70 transition-opacity hover:opacity-100" />
      <img src="/media/logo-kestrel.svg" alt="Kestrel" height="28" class="h-7 w-auto opacity-70 transition-opacity hover:opacity-100" />
      <img src="/media/logo-fathom.svg" alt="Fathom" height="28" class="h-7 w-auto opacity-70 transition-opacity hover:opacity-100" />
      <img src="/media/logo-juniper.svg" alt="Juniper" height="28" class="h-7 w-auto opacity-70 transition-opacity hover:opacity-100" />
      <img src="/media/logo-quanta.svg" alt="Quanta" height="28" class="h-7 w-auto opacity-70 transition-opacity hover:opacity-100" />
    </div>
  </div>
</section>
